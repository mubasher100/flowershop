# The Medusa admin pulls React 18 while the storefront is on React 19, so a
# plain `npm ci` fails on the peer conflict. The lockfile was generated with
# --legacy-peer-deps; setting it here means CI, Railway, and local installs
# all behave identically without repeating the flag at every call site.
#
# (`auto-install-peers` was in the starter but is a pnpm setting — npm warns
# it's unknown on every install.)
legacy-peer-deps=true
