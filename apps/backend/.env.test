# Committed on purpose — contains no secrets.
#
# SAFETY: Medusa's loadEnv("test") reads `.env.test` first, then falls back to
# `.env`. Without this file, `npm run test:integration:http` would inherit the
# Supabase DATABASE_URL from `.env` — and the test runner CREATES AND DROPS
# databases. Pointing tests at localhost keeps them away from production.
#
# Local integration tests therefore need a local Postgres:
#   docker run -d --name medusa-test -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16-alpine
#
# In CI these values are ignored: the workflow sets DATABASE_URL in the
# environment, and dotenv never overrides an already-set variable.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa_test
REDIS_URL=
JWT_SECRET=test-jwt-secret
COOKIE_SECRET=test-cookie-secret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
