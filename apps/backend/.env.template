# Copy to `.env` and fill in. Never commit `.env`.

# --- Database (Supabase) -----------------------------------------------------
# Use the SESSION POOLER (port 5432). NOT the transaction pooler (6543) — it
# breaks MikroORM prepared statements and migrations.
# Supabase Dashboard → Project Settings → Database → Connection string → Session pooler
#
# Do NOT append ?sslmode=require. node-postgres treats it as verify-full, which
# rejects Supabase's cert chain with SELF_SIGNED_CERT_IN_CHAIN. TLS is already
# handled by databaseDriverOptions in medusa-config.ts.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# --- Redis -------------------------------------------------------------------
# Drives cache, event bus, workflow engine, and locking.
# Leave EMPTY locally to fall back to in-memory (fine for dev, NOT for production).
# In production this is Railway's private Redis URL.
REDIS_URL=

# --- Secrets -----------------------------------------------------------------
# Generate real values before deploying: openssl rand -base64 32
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# --- CORS --------------------------------------------------------------------
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:8000,http://localhost:9000

# --- Runtime -----------------------------------------------------------------
MEDUSA_BACKEND_URL=http://localhost:9000
# shared = API + worker in one process. Split to server/worker under load.
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# --- SkipCash (Phase 8 — not implemented yet) --------------------------------
# Sandbox:    https://skipcashtest.azurewebsites.net
# Production: https://api.skipcash.app
SKIPCASH_BASE_URL=
SKIPCASH_CLIENT_ID=
SKIPCASH_KEY_ID=
SKIPCASH_KEY_SECRET=
SKIPCASH_WEBHOOK_KEY=
