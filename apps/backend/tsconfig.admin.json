{
  /**
   * The admin dashboard, type-checked on its own terms.
   *
   * Vite bundles this folder as ESM — `import.meta.env` is how it reads its
   * build-time config — so it cannot be checked under the server's Node16 /
   * CommonJS settings without TS1470 on every use. `medusa build` hands the
   * folder to Vite, which strips types without checking them, so without
   * this config the dashboard is the one part of the codebase nothing
   * type-checks at all.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "react": ["../../node_modules/@types/react"],
      "react-dom": ["../../node_modules/@types/react-dom"],
      "react/jsx-runtime": ["../../node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": ["src/admin/**/*", ".medusa/types/*"],
  "exclude": ["node_modules", ".medusa/server"]
}
