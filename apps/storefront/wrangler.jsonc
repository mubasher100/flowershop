{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowershop-storefront",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  // nodejs_compat is required by OpenNext — the Next.js server bundle uses
  // Node built-ins that Workers doesn't provide by default.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Incremental cache. Without a persistent store, every isolate re-renders
  // pages from scratch and re-fetches the Store API — the bucket lives in
  // APAC, alongside the backend and database.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "flowershop-cache"
    }
  ],
  "observability": {
    "enabled": true
  }
}
