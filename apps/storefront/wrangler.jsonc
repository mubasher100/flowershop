{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowershop-storefront",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  // nodejs_compat is required by OpenNext — the Next.js server bundle uses
  // Node built-ins that Workers doesn't provide by default.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Incremental cache. Without a persistent store, every isolate re-renders
  // pages from scratch and re-fetches the Store API — the bucket lives in
  // APAC, alongside the backend and database.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "flowershop-cache"
    }
  ],
  // Tag cache. Without it revalidateTag is a no-op, so a product edited in
  // the admin never reaches the storefront until the page's own revalidate
  // window expires. The binding name is fixed by the adapter, and the worker
  // OpenNext generates already exports the class.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  // new_sqlite_classes, not new_classes: the tag cache uses SQLite-backed
  // storage, which is also what makes it available without a paid plan.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOShardedTagCache"]
    }
  ],
  // The shop's own domain. Custom domains, not routes: Cloudflare creates the
  // DNS records and certificate, and the zone has to be in the same account
  // as the Worker. www redirects to the apex in middleware.
  "routes": [
    { "pattern": "tulipsandtruffle.com", "custom_domain": true },
    { "pattern": "www.tulipsandtruffle.com", "custom_domain": true }
  ],
  // Keep the workers.dev address too — wrangler switches it off once routes
  // exist. It is the test address; the domain is the real one.
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
