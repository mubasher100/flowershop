# Copy to `.env.local` and fill in. Never commit `.env.local`.

# Medusa backend. Local dev: http://localhost:9000 — production: the Railway URL.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# REQUIRED. Store API requests are rejected without it.
# Medusa Admin → Settings → API Key Management → Publishable API Keys
# The key must be linked to a sales channel.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# This storefront's own public URL.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region country code. Qatar.
NEXT_PUBLIC_DEFAULT_REGION=qa

# Trader identity, shown in the footer and on the privacy / terms / returns
# pages as Qatar's e-commerce rules require. Unset rows are not rendered.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_CR=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty and no
# analytics script is loaded.
NEXT_PUBLIC_GA_ID=
