# Copy to `.env.local` and fill in. Never commit `.env.local`.

# Medusa backend. Local dev: http://localhost:9000 — production: the Railway URL.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# REQUIRED. Store API requests are rejected without it.
# Medusa Admin → Settings → API Key Management → Publishable API Keys
# The key must be linked to a sales channel.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# This storefront's own public URL.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region country code. Qatar.
NEXT_PUBLIC_DEFAULT_REGION=qa
