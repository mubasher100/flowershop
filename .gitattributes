# Normalize line endings so Windows checkouts don't break CI on Linux.
* text=auto eol=lf

# Never let CRLF near these — Linux runners fail on \r in shebangs/YAML.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows-only files keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary — don't diff or convert.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.pdf  binary
package-lock.json -diff
